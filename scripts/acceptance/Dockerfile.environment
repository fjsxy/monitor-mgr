# 环境探针只追加到同源产品，目标卷仍由 UID10001 真正读写。
ARG PLATFORM_IMAGE=monitor-mgr:development
FROM golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66 AS probe
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY scripts/acceptance/environmentfixture/ scripts/acceptance/environmentfixture/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /volumeprobe ./scripts/acceptance/environmentfixture
FROM ${PLATFORM_IMAGE}
COPY --from=probe /volumeprobe /volumeprobe
ENTRYPOINT ["/volumeprobe"]
CMD ["-data-dir","/data","-expected-uid","10001"]
