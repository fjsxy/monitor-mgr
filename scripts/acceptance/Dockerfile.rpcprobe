# 验收专用镜像只追加直接RPC探针；平台二进制和页面来自明确的产品镜像。
ARG PLATFORM_IMAGE
FROM golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66 AS probe
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY kitex_gen/ kitex_gen/
COPY scripts/acceptance/rpcprobe/ scripts/acceptance/rpcprobe/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /rpcprobe ./scripts/acceptance/rpcprobe
FROM ${PLATFORM_IMAGE}
COPY --from=probe /rpcprobe /rpcprobe
